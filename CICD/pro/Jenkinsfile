pipeline {
    agent { label 'docker' }

    environment {
        DOCKER_IMAGE_TAG = 'pro'
        DOCKER_REGISTRY_PUSH_URL = '38.55.97.233:5000' // Docker私有仓库的推送URL
        DOCKER_REGISTRY_PULL_URL = '38.55.97.233:5001' // Docker私有仓库的拉取URL
        DOCKER_IMAGE = 'tool-ai-demo'  // 要构建和推送的 Docker 镜像名称
        DOCKER_CONTAINER = 'tool-ai-demo'
        DOCKER_CREDENTIALS_ID = 'docker-registry-credentials'
        REMOTE_HOST = '38.55.97.233'
        REMOTE_SSH_PORT = '22'
        DEPLOY_USERNAME = 'root'
        DEPLOY_PASSWORD = 'yhxeBZiQBu0G'
    }

    stages {
        stage('Verify Docker') {
            steps {
                sh 'docker version || which docker || echo "Docker not found" && exit 1'
            }
        }
        stage('Build Docker Image') {
            steps {
                // 构建 Docker 镜像
                sh 'docker build -t $DOCKER_REGISTRY_PUSH_URL/$DOCKER_IMAGE:$DOCKER_IMAGE_TAG  -f Dockerfile .'
            }
        }
        stage('Publish Image') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-registry-credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                        sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin $DOCKER_REGISTRY_PUSH_URL'
                        sh 'docker push $DOCKER_REGISTRY_PUSH_URL/$DOCKER_IMAGE:$DOCKER_IMAGE_TAG'
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    // 定义远程服务器的SSH凭证
                    def remoteServer = [
                        remoteHost: REMOTE_HOST,
                        sshPort: 22
                    ]

                    // 定义镜像名称
                    def image = DOCKER_REGISTRY_PULL_URL+'/'+DOCKER_IMAGE+':'+DOCKER_IMAGE_TAG

                    // 使用用户名和密码登录
                    def USERNAME = DEPLOY_USERNAME
                    def PASSWORD = DEPLOY_PASSWORD
                    // 检查并停止旧容器
                    def container_id = sh(script: "sshpass -p '${PASSWORD}' ssh -o StrictHostKeyChecking=no ${USERNAME}@${remoteServer.remoteHost} -p ${remoteServer.sshPort} 'docker ps -a | awk \"/${DOCKER_CONTAINER}/ {print \\\$1}\"'", returnStdout: true).trim()
                    if (container_id) {
                        echo "[DOCKER] 停止并删除已经启动的容器"
                        sh "sshpass -p '${PASSWORD}' ssh -o StrictHostKeyChecking=no ${USERNAME}@${remoteServer.remoteHost} -p ${remoteServer.sshPort} 'docker stop ${container_id}'"
                        sh "sshpass -p '${PASSWORD}' ssh -o StrictHostKeyChecking=no ${USERNAME}@${remoteServer.remoteHost} -p ${remoteServer.sshPort} 'docker rm ${container_id}'"
                    }

                    // 检查镜像是否存在并删除镜像（使用 awk 精确匹配，避免 GString 中 $ 转义问题）
                    def checkCmd = "docker images --format \"{{.Repository}}:{{.Tag}}\" | awk -v img=\"${image}\" '\\$0==img {f=1} END{exit f?0:1}'"
                    def image_exists = sh(script: "sshpass -p '${PASSWORD}' ssh -o StrictHostKeyChecking=no ${USERNAME}@${remoteServer.remoteHost} -p ${remoteServer.sshPort} '${checkCmd}'", returnStatus: true) == 0
                    if (image_exists) {
                        echo "[DOCKER] 镜像存在，执行删除操作..."
                        sh "sshpass -p '${PASSWORD}' ssh -o StrictHostKeyChecking=no ${USERNAME}@${remoteServer.remoteHost} -p ${remoteServer.sshPort} 'docker rmi ${image}'"
                    } else {
                        echo "[DOCKER] 镜像不存在，无需删除。"
                    }
                    echo "[DOCKER-COMPOSE] 重新启动容器"
                    // 重新部署容器
                    sh "sshpass -p '${PASSWORD}' ssh -o StrictHostKeyChecking=no ${USERNAME}@${remoteServer.remoteHost} -p ${remoteServer.sshPort} 'docker-compose -f /workspace/docker/docker-compose.yml up -d --build ${DOCKER_CONTAINER}'"
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed :('
        }
    }
}
